{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HMI工具链JSONL事件 v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "event": {
      "enum": [
        "command_started",
        "stage_started",
        "task_started",
        "task_action",
        "task_finished",
        "task_progress",
        "detail",
        "output_written",
        "diagnostic",
        "result"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "result"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "cli-result-v2.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "task_progress"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "progress": {
                "$ref": "#/$defs/progress"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "task_started",
              "task_finished",
              "task_action"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "task": {
                "properties": {
                  "progress": {
                    "$ref": "#/$defs/progress"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "progress": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "enum": [
            "frames",
            "sample_frames"
          ]
        }
      },
      "required": [
        "phase",
        "current",
        "total",
        "unit"
      ],
      "additionalProperties": false,
      "description": "同一phase内计数递增；phase改变后从0开始。total为null时不推测总量或百分比。"
    }
  }
}
